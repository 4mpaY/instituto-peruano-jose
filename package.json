{
  "name": "aula-virtual",
  "version": "2.0.0",
  "license": "Commercial",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build:icons && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "build:icons": "tsx src/utils/assets/iconify-icons/bundle-icons-css.ts",
    "db:client:setup": "prisma db pull --schema ./prisma/schema.prisma && prisma generate --schema ./prisma/schema.prisma",
    "db:client:generate": "prisma generate --schema ./prisma/schema.prisma",
    "db:migration:dev": "prisma migrate dev --schema ./prisma/schema.prisma",
    "db:client:push": "prisma db push --schema ./prisma/schema.prisma & prisma generate --schema ./prisma/schema.prisma",
    "db:migration:deploy": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "db:main:seed": "dotenv -- tsx ./prisma/seed/main",
    "db:instituto-peruano:seed": "dotenv -- tsx ./prisma/seed/instituto-peruano",
    "db:test-evaluaciones:seed": "dotenv -- tsx ./prisma/seed/test-evaluaciones"
  },
  "prisma": {
    "seed": "tsx prisma/seed_student.ts"
  },
